# 每一项都可以删掉，删掉即使用下面注释里写的默认值。
# 注意入口执行的是 load_dotenv(override=True)，本文件的取值优先于 shell 环境变量。

# --- 出站 HTTP 通道 ---------------------------------------------------------
# auto | proxy | impersonate | direct
#   auto        网关可用则 proxy，否则降级 impersonate（默认）
#   proxy       经授权网关和代理出口（需要 AKSHARE_PROXY_GATEWAY，按积分计费）
#   impersonate 本机直连 + 浏览器 TLS 指纹伪装，无需网关
#   direct      本机直连 + 原生 requests，即引入该开关之前的行为（可写作 off）
# 四种模式互斥；只接管 push2/push2his/fund/emweb.securities 四个东方财富主机
CN_STOCK_HTTP_MODE=auto
# impersonate 通道：目标主机的尝试次数、单次超时秒数、伪装的浏览器
CN_STOCK_HTTP_IMPERSONATE_RETRY=3
CN_STOCK_HTTP_IMPERSONATE_TIMEOUT=8
CN_STOCK_HTTP_IMPERSONATE_PROFILE=chrome
# 连续多少个主机完全失败后暂停伪装通道，以及暂停时长
CN_STOCK_HTTP_IMPERSONATE_FAILURE_THRESHOLD=4
CN_STOCK_HTTP_IMPERSONATE_COOLDOWN_SECONDS=300

# --- AkShare Proxy Patch（可选，付费）---------------------------------------
# 默认关闭，不配置也能正常使用全部工具；只作为 CN_STOCK_HTTP_MODE=auto 的判定输入
AKSHARE_PROXY_ENABLED=0
# 网关地址，不含协议和端口（旧名 AKSHARE_PROXY_IP）
AKSHARE_PROXY_GATEWAY=
# 访问令牌（旧名 AKSHARE_PROXY_PASSWORD）
AKSHARE_PROXY_TOKEN=
# 失败重试次数（旧名 AKSHARE_PROXY_PORT，它表示重试次数而不是端口）
AKSHARE_PROXY_RETRY=30

# --- 盘中行情与资金流 -------------------------------------------------------
# 盘中实时行情的尝试顺序，逗号分隔；置 off 关闭整层。
# fund_flow_page 复用已解析的资金流页面，不发请求但没有开高低；tencent 走
# qt.gtimg.cn，六项俱全。兜底 K 线源盘中不含当天，靠这一层补上。
CN_STOCK_INTRADAY_QUOTE_PROVIDERS=fund_flow_page,tencent
# 东财资金流接口不可用时，是否回退到浏览器加载的资金流向页面
CN_STOCK_FUND_FLOW_PAGE_FALLBACK_ENABLED=1
# 同时进行的兜底页面加载数；调高会挤占实时资金流的浏览器额度
CN_STOCK_FUND_FLOW_PAGE_FALLBACK_CONCURRENCY=1
# 等不到槽位就跳过兜底、改渲染“盘中实时数据暂时不可用”的等待秒数
CN_STOCK_FUND_FLOW_PAGE_FALLBACK_WAIT_SECONDS=0.5
# 等历史表渲染完成的上限；请求被拒时会提前结束，不会白等满
CN_STOCK_FUND_FLOW_PAGE_TABLE_WAIT_SECONDS=15
# 同一标的页面解析结果的复用窗口；设为 0 关闭复用
CN_STOCK_FUND_FLOW_PAGE_REUSE_SECONDS=30
# 本进程还没成功取到过数据时，单次请求允许的页面加载次数
CN_STOCK_FUND_FLOW_PAGE_COLD_ATTEMPTS=2
# 连续多少次徒劳加载后暂停整层兜底，以及暂停时长
CN_STOCK_FUND_FLOW_PAGE_FALLBACK_FAILURE_THRESHOLD=2
CN_STOCK_FUND_FLOW_PAGE_FALLBACK_COOLDOWN_SECONDS=300

# --- 上游源熔断 -------------------------------------------------------------
# 某个上游源连续失败时直接跳过，冷却结束后放行一次探测请求
CN_STOCK_SOURCE_BREAKER_ENABLED=1
CN_STOCK_SOURCE_BREAKER_THRESHOLD=3
CN_STOCK_SOURCE_BREAKER_COOLDOWN_SECONDS=120

# --- 并发与线程池 -----------------------------------------------------------
# 同步行情数据线程池大小；Ubuntu 2 核 4G 建议保持 8
CN_STOCK_DATA_FETCH_MAX_WORKERS=8
# 同步行情运行中和排队中的任务总上限
CN_STOCK_DATA_FETCH_MAX_IN_FLIGHT=16
# brief、medium、full 同时处理的批次数上限
CN_STOCK_BATCH_QUERY_CONCURRENCY=2
# 财务摘要缓存秒数；设为 0 可关闭
CN_STOCK_FINANCE_CACHE_TTL_SECONDS=21600
# 财务摘要缓存的最大标的数
CN_STOCK_FINANCE_CACHE_MAX_ENTRIES=512

# --- 报告缓存 ---------------------------------------------------------------
# 是否启用报告缓存
CN_STOCK_REPORT_CACHE_ENABLED=1
# 盘中报告缓存秒数；设为 0 时盘中不复用
CN_STOCK_REPORT_CACHE_LIVE_TTL_SECONDS=30
# 收盘后进入稳定缓存纪元的时间，格式 HHMM，取值夹在 1500-1700
CN_STOCK_REPORT_CACHE_SETTLE_HHMM=1530
# 内存报告缓存最大条目数
CN_STOCK_REPORT_CACHE_MAX_ENTRIES=512
# 是否启用跨重启的磁盘报告缓存
CN_STOCK_REPORT_CACHE_DISK_ENABLED=1
# 报告缓存目录；相对路径基于项目根目录
CN_STOCK_REPORT_CACHE_DIR=.runtime/report-cache

# --- 浏览器与显示 -----------------------------------------------------------
# 同花顺认证缓存文件；留空时使用 .runtime/tonghuashun-auth.json
CN_STOCK_TONGHUASHUN_AUTH_FILE=
# 同花顺认证失败后的冷却秒数
CN_STOCK_TONGHUASHUN_COOLDOWN_SECONDS=300
# 是否为 Chromium 添加 --no-sandbox；仅在受控容器确有需要时设为 1
CN_STOCK_CHROME_NO_SANDBOX=0
# Ubuntu 无 DISPLAY 时自动使用的 Xvfb 起始显示号
CN_STOCK_XVFB_DISPLAY_NUMBER=99
# Ubuntu Xvfb 屏幕分辨率和色深
CN_STOCK_XVFB_SCREEN=1920x1080x24

# --- 调试开关（默认关，会显著抬高内存，只在排查时开）------------------------
# 资金流页面用有头浏览器加载，便于人工观察渲染结果
CN_STOCK_FUND_FLOW_PAGE_HEADFUL=0
# 抓完不关页面；每个页面是一个独立渲染进程
CN_STOCK_FUND_FLOW_PAGE_KEEP_PAGES=0
