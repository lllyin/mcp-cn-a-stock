# 每一项都可以删掉，删掉即使用下面注释里写的默认值。
# 注意入口执行的是 load_dotenv(override=True)，本文件的取值优先于 shell 环境变量。
#
# 配置名不带前缀，akshare-proxy-patch 那一组除外（那是第三方插件的名字，见下）。
# 要和别的程序共存、担心重名时设 ENV_PREFIX，之后所有配置都读带前缀的名字
# （例如 ENV_PREFIX=CNSTOCK_ 时读 CNSTOCK_HTTP_CHANNEL）。
# ENV_PREFIX=

# --- 出站 HTTP 通道 ---------------------------------------------------------
# auto | proxy | impersonate | direct
#   auto        网关可用则 proxy，否则降级 impersonate（默认）
#   proxy       经授权网关和代理出口（需要 AKSHARE_PROXY_GATEWAY，按积分计费）
#   impersonate 本机直连 + 浏览器 TLS 指纹伪装，无需网关
#   direct      本机直连 + 原生 requests，即引入该开关之前的行为（可写作 off）
# 四种模式互斥；只接管 push2/push2his/fund/emweb.securities 四个东方财富主机
HTTP_CHANNEL=auto
# impersonate 通道：目标主机的尝试次数、单次超时秒数、伪装的浏览器
IMPERSONATE_RETRY=3
IMPERSONATE_TIMEOUT_SECONDS=8
IMPERSONATE_BROWSER=chrome
# 连续多少次请求打满重试仍失败后暂停伪装通道，以及暂停时长。
# 暂停期内这四个主机退回原生 requests——而它们被列进来的理由正是拒绝原生
# requests，所以这期间东财源会直接跳过，不再逐个源去重新发现一遍。
IMPERSONATE_SUSPEND_AFTER_FAILURES=4
IMPERSONATE_SUSPEND_SECONDS=300

# --- AkShare Proxy Patch（可选，付费）---------------------------------------
# 这一组保留 AKSHARE_PROXY_ 前缀：配的是第三方插件 akshare-proxy-patch，
# 前缀就是插件的身份，不跟着本项目的去前缀规则走。
# 默认关闭，不配置也能正常使用全部工具；只作为 HTTP_CHANNEL=auto 的判定输入
AKSHARE_PROXY_ENABLED=0
# 网关地址，不含协议和端口
AKSHARE_PROXY_GATEWAY=
# 访问令牌
AKSHARE_PROXY_TOKEN=
# 网关请求的失败重试次数。插件的第三个参数是重试次数不是端口，早年误名为
# AKSHARE_PROXY_PORT，那个名字仍然认。
AKSHARE_PROXY_RETRY=30

# --- 基本数据（总市值、市盈率、市净率）-------------------------------------
# 取数顺序，逗号分隔按序尝试，置 off 关闭整层。后面的源会补前面缺的字段。
#   eastmoney  efinance 的 base_info + quote_snapshot，字段最全，需要网关或未被封的出口
#   tencent    qt.gtimg.cn 长表，无需鉴权；与东财逐项比对过，市值和市盈率 0.000% 一致
# 没有 akshare-proxy-patch 的部署靠 tencent 兜住这一组，否则会连带丢掉
# 市盈率(静) 和换手率——那两项要总股本和流通股本。
BASIC_INFO_PROVIDERS=eastmoney,tencent

# --- 盘中行情与资金流 -------------------------------------------------------
# 盘中实时行情的尝试顺序，逗号分隔；置 off 关闭整层。
# fund_flow_page 复用已解析的资金流页面，不发请求但没有开高低；tencent 走
# qt.gtimg.cn，六项俱全。兜底 K 线源盘中不含当天，靠这一层补上。
INTRADAY_QUOTE_PROVIDERS=fund_flow_page,tencent
# 拿到第一个可用报价后再问剩下的源一遍，字段相差超过这个百分比就打 WARNING。
# 置 0 关闭（默认）。开着每个标的多一次上游请求，只在怀疑某个源口径不对时开。
INTRADAY_QUOTE_CROSS_CHECK_PCT=0
# 东财资金流接口不可用时，是否回退到浏览器加载的资金流向页面
FUND_FLOW_PAGE_ENABLED=1
# 同时进行的兜底页面加载数。要和 BROWSER_MAX_PAGES 一起调：两者是串联的闸门，
# 只提其中一个，另一个立刻变成新瓶颈。
FUND_FLOW_PAGE_CONCURRENCY=3
# 单个标的等一个名额的上限。这个值必须大于一次页面加载的耗时（服务器实测
# p50 3.4s / p90 7.5s），否则一批 4 个标的里的最后一个结构上永远排不到。
FUND_FLOW_PAGE_QUEUE_WAIT_SECONDS=8
# 一次请求里所有标的加起来最多为等名额花掉多少秒。是截止时间不是配额，
# 必须大于上面那个，否则上面提了也会被它削回来。置 0 关闭。
FUND_FLOW_PAGE_REQUEST_BUDGET_SECONDS=15
# 等历史表渲染完成的上限；请求被拒时会提前结束，不会白等满
FUND_FLOW_PAGE_TABLE_WAIT_SECONDS=15
# 同一标的页面解析结果的复用窗口；设为 0 关闭复用
FUND_FLOW_PAGE_REUSE_SECONDS=30
# 单次请求允许的页面加载次数。被拒直接换 tab（刷新带不走滑块，新 tab 才带得走）；
# 没被拒只是没填完才在同一个 tab 上 reload。只在没拿到想要的数据时才会用掉。
# 不要调到 5：部署机 09-07 上午就是 5，每标的最多 10 次加载压在十几秒内，把偶发的拒绝
# 放大成整批滑块。
FUND_FLOW_PAGE_MAX_LOADS=2
# reload 之前的随机等待毫秒区间，写作“下界,上界”；只写一个数就是固定值，
# 置 0 关闭。只作用在重试路径上，顺利路径不受影响——没拿到数据后 0 毫秒就刷新
# 同一个页面是个机器节奏。
FUND_FLOW_PAGE_RETRY_DELAY_MS=250,350
# 多少次徒劳加载后暂停整层兜底，以及暂停时长。按下面这个滑动窗口计数，不是
# 连续计数——被拒是逐次随机的，连续计数两头都不准。窗口置 0 退回连续计数。
FUND_FLOW_PAGE_OPEN_AFTER_FAILURES=4
FUND_FLOW_PAGE_FAILURE_WINDOW_SECONDS=60
FUND_FLOW_PAGE_COOLDOWN_SECONDS=60

# --- 交易日历 ---------------------------------------------------------------
# 判"今天开不开市"用的日历来源，逗号分隔按序尝试。判断入口统一在 finmcp.market_calendar。
#   sina        上交所公布的交易日名单（经 AkShare），实测 8797 行 / 0.18s / 69 KiB
#   holiday_cn  NateScarlet/holiday-cn 的国务院放假安排，按年取，每年约 5 KiB 裸 GET
#   weekday     兜底：周一到周五算交易日，也就是接入日历之前的行为
# 三级的差别是量出来的（2024-01-02..2026-12-31 共 728 天，以 sina 为答案）：
#   holiday_cn 一致 727/728 = 99.863%，唯一差异 2024-02-09 除夕交易所比国务院多休一天
#   weekday    错 56 天（春节、国庆整段被算成交易日）
# 所以中间这一级救回 55 天。weekday 放最后是有意的：它让降级从代码里的暗礁变成
# 配置里看得见的一行。整层置 off 会退回按星期判断。
TRADING_CALENDAR_PROVIDERS=sina,holiday_cn,weekday

# --- 历史 K 线兜底源 ---------------------------------------------------------
# 东财那一级取不到时，按这个顺序问下去；逗号分隔，置 off 关掉整层。
#   tonghuashun d.10jqka.com.cn 免鉴权接口，唯一和东财口径一致的免费源；
#               创业板指的成交量只有它和东财是对的，腾讯/新浪都低 3.5%。不覆盖北交所
#   tencent     stock_zh_a_hist_tx，个股/ETF/指数都覆盖，北交所大半不认
#   sina        stock_zh_a_daily，覆盖腾讯不认的北交所代码；但 ETF 和创业板指
#               走这个端点是 JSONDecodeError
# 三家各补各的洞。接新源只需写一个 platforms/<名字>.py 再把名字加进这里。
#
# 分两条顺序，两条的判据不一样：
# 个股/ETF 这条按**稳定性**排——各源的分歧只有 0.015~0.08%（美的 MA60/120/240，
# 用同花顺+平安证券核对过，准的其实是同花顺），小到可以忽略，于是让请求更少、
# 解析由 AkShare 维护的腾讯排前面。
KLINE_PROVIDERS=tencent,sina
# 指数这条按**准确度**排——创业板指成交量东财/同花顺 200,462,510 手、
# 腾讯/新浪 193,413,042 手，差 3.52%，这个量级不能忽略。
KLINE_PROVIDERS_INDEX=tonghuashun,tencent,sina

# 相邻两根 K 线之间允许缺多少个**交易日**，超过就判该源失败、让链路回退；置 0 关闭。
# 防的是序列断裂：缺列会让契约当场判失败，而断裂的序列列是齐的、数值也在合理区间，
# 源「成功」返回，没有任何东西会拦它。实际发生过：SH000688 的涨跌幅报成 +20.17%
#（真实 +2.41%），成因是同花顺某年份文件取失败被静默跳过，当天前面那一根
# 从 1577.36 变成 1344.07；同一份报告 240 日均价 1540 → 1148、240 日最高 2255 → 1626。
#
# 单位是交易日不是自然日：数自然日只是「别把长假当缺口」的代理指标，而实测春节能到
# 11 个自然日，余量很薄。问交易日历之后长假在结构上就是 0（33 条真实序列实测缺 0 个
# 交易日），阈值只剩一个真问题——容忍几天停牌。10 是 2018 年后重大资产重组停牌的
# 上限，所以合规停牌不触发额外回退；漏一个年份文件是 242 个交易日、漏一季度 60，
# 都远在阈值之上。日历取不到时退回按星期数，最长的长假被数成 6，仍在 10 之内。
#
# 偏好不是硬条件：真实长期停牌时每个源都带同样的缺口，那一轮会宽松重问、放行带
# 缺口的序列（status 里留 kline_gap_tolerated），不会让 K 线这一维整段消失。
KLINE_MAX_GAP_TRADING_DAYS=10

# --- 个股 / 指数资金流 -----------------------------------------------------
# HTTP 这一层的取数顺序；浏览器页面兜底不在这条链里，它挂在这一层之后。
#   eastmoney        push2his 的 fflow/daykline，经 AkShare，给全部历史；走伪装通道
#   eastmoney_delay  push2delay 主机上的同一个接口，只回最近一天，但不在伪装通道的
#                    接管名单里——push2his 拒绝出口 IP 时它还通。它补的是没有资金流向
#                    页面的标的（科创 50 这类指数）；有页面的标的编排层仍会去页面补历史
FUND_FLOW_PROVIDERS=eastmoney,eastmoney_delay

# --- 无页面标的的盘中实时资金流 ----------------------------------------------
# 科创50 这类没有资金流向页面的标的，盘中日线里又没有当天那一行，原先只能"暂无"。
#   eastmoney_delay  push2delay 的分钟线 fflow/kline/get?klt=1，最后一行是当日累计五档净流入
#                    （2026-09-07 实测盘中可用，部署机能到该主机）。不给净占比，报告里用
#                    净流入除以当日成交额算。有页面的标的仍走浏览器，不走这里。
# 置 off 退回"暂无实时资金流向"。
REALTIME_FUND_FLOW_PROVIDERS=eastmoney_delay

# --- 板块资金流 -------------------------------------------------------------
# 行业/概念/地域板块资金流排行的取数顺序。
#   eastmoney          push2 clist 接口，字段全（涨跌幅、四档明细、领涨股），走伪装通道
#   eastmoney_dataapi  data.eastmoney.com 的 dataapi，只有主力净额（三个口径都有），
#                      但不在伪装通道的接管名单里——push2 连不上时它直连还通。
#                      降级形态，会在报告的备注里标出来
SECTOR_FUND_FLOW_PROVIDERS=eastmoney,eastmoney_dataapi

# --- 板块分级 -------------------------------------------------------------
# 东财的行业板块名单是一棵树摊平的（实测 496 个，含申万一、二、三级），直接取
# Top N 会把父子一起排进来、同一笔钱数两遍。层级从分类标准本身取，不靠猜名字。
#   shenwan      申万宏源的行业分类（经 AkShare 抓乐咕乐股页面），一级 31 个和东财板块名 31/31 全对得上
#   swsresearch  申万宏源研究所官网的 JSON 接口，同一套分类、另一个上游。乐咕乐股对机房 IP
#                回 302 人机验证页（部署机 2026-09-06 实测）时靠它；二级比乐咕少 7 个小板块
# 同一套标准的源会合并：前一个缺的级由后一个补，同名冲突信先配置的；前一个给全就不问后一个。
# 置 off 会退回"全部板块一起排"，报告里会标出来。
SECTOR_TAXONOMY_PROVIDERS=shenwan,swsresearch

# --- 上游源熔断 -------------------------------------------------------------
# 某个上游源连续失败时直接跳过，冷却结束后放行一次探测请求
SOURCE_BREAKER_ENABLED=1
SOURCE_BREAKER_OPEN_AFTER_FAILURES=3
SOURCE_BREAKER_COOLDOWN_SECONDS=120

# --- 并发与线程池 -----------------------------------------------------------
# 同步行情数据线程池大小；Ubuntu 2 核 4G 建议保持 8
FETCH_MAX_WORKERS=8
# 同步行情运行中和排队中的任务总上限
FETCH_MAX_IN_FLIGHT=16
# brief、medium、full 同时处理的批次数上限
BATCH_CONCURRENCY=2
# 财务摘要缓存秒数；设为 0 可关闭
FINANCE_CACHE_TTL_SECONDS=21600
# 财务摘要缓存的最大标的数
FINANCE_CACHE_MAX_ENTRIES=512

# --- 市场纪元边界 -----------------------------------------------------------
# 交易所的时刻表是死的（09:30 开盘 / 11:30 午休 / 13:00 续盘 / 15:00 收盘，代码里是
# 常量），但**上游不在这些时刻定稿**：盘前上游已经在更新当日数据了，盘后东财的资金流
# 页面还在整理。提前多少、延后多少取决于上游当时的行为，会变，所以这几项能配。
# 越界会夹回合法区间并打 WARNING，不会让服务起不来。
#
# 从这一刻起按盘中对待。晚于 0930 会把真在交易的一段判成闭市，所以上界是开盘。
MARKET_EPOCH_WARMUP_TIME=0915
# 当日数据从这一刻起算定稿、报告可以完全复用。早于 1500 会把仍在变动的连续竞价
# 折进完全复用纪元，所以下界是收盘。
MARKET_EPOCH_SETTLE_TIME=1530
# 资金流从"抓页面"切回"读接口"的时刻，同时是纪元边界——两者必须是同一个值，
# 拆开会让一个纪元横跨翻转点，同一纪元里出现两种形状的报告。
MARKET_EPOCH_FINAL_TIME=1600
# 午休、傍晚这些边界后留给上游整理的缓冲分钟数。
MARKET_EPOCH_BUFFER_MINUTES=5

# --- 缓存 -------------------------------------------------------------------
# 缓存唯一的正当理由是"这段时间里这份数据不会变"。防风控、省积分、变快都是这条成立
# 之后自然得到的好处，不是判据。设计见 docs/cache-design.md。
#
# 总开关。关掉之后所有命名空间既不读也不写——prove_equivalence.py 的"关掉缓存再比对"
# 要的就是这个语义，关不干净那个证明就是假的。
CACHE_ENABLED=1
# 盘中软过期秒数的默认值；设为 0 时盘中绝不复用。
CACHE_INTRADAY_TTL_SECONDS=30
# 软过期后刷新失败，是否继续用旧值。用了一定会在输出里标注。
# 跨纪元的旧值永远不给——那不是"旧"，是另一个交易日的数据。
CACHE_STALE_ON_ERROR=1
# 是否启用跨重启的磁盘层。闭市纪元长达 16 小时（周末 64 小时），只有内存层的话
# 每次重部署都把它丢光。
CACHE_DISK_ENABLED=1
# 磁盘层目录；相对路径基于项目根目录。每个命名空间一个子目录。
CACHE_DIR=.runtime/cache
# 单个命名空间的覆盖：CACHE_<命名空间>_TTL_SECONDS / CACHE_<命名空间>_MAX_ENTRIES
# 命名空间：report、fund_flow、realtime、market_events、sector_flow、market_breadth、
# finance、calendar、taxonomy
CACHE_REPORT_MAX_ENTRIES=512
# 资金流历史一条最多存多少行。主源 lmt=0 给全部历史，老标的数千行、一条 182 KiB，
# 条数上限乘上去就不可忽略；截断到 250 行后一条 38 KiB，而实测用到的最大
# fund_flow_limit 是 60、页面兜底本来也只给 120 行。请求要的行数超过存下来的，
# 命中判定会失败、照常打上游，所以截断不会让数据变少。
CACHE_FUND_FLOW_MAX_ROWS=250
# 单个命名空间的开关：CACHE_<命名空间>_ENABLED，缺省跟随 CACHE_ENABLED。
# 存在的理由是 A/B——要量"这一层缓存值多少"就得只关它；只有总开关时关掉它连
# 报告缓存一起没了，测出来的是两层加起来的收益，没法归因到某一层。
# 例：CACHE_FUND_FLOW_ENABLED=0 只关资金流那一层。

# --- 市场宽度（同花顺）------------------------------------------------------
# 同花顺认证缓存文件；留空时使用 .runtime/tonghuashun-auth.json
MARKET_BREADTH_AUTH_FILE=
# 同花顺认证失败后的冷却秒数
MARKET_BREADTH_COOLDOWN_SECONDS=300

# --- 浏览器与虚拟显示 -------------------------------------------------------
# 资金流兜底和市场宽度共用同一个浏览器实例，下面几项对两者同时生效。
# 整个浏览器同时开着的页面数上限。这同时就是「同时几个渲染进程」，是峰值内存的
# 直接决定项：每多一个并发页约 +130 MiB。要和 FUND_FLOW_PAGE_CONCURRENCY 一起调。
BROWSER_MAX_PAGES=3
# 盘中（含午休）多久没人用就把浏览器整个拆掉，秒。置 0 = 整层关闭回收（总开关，
# 不看时段）。90 分钟是为了盖住午休：拆早了下一批调用要重新付一次冷启动（+2.19s）。
BROWSER_IDLE_TIMEOUT_SECONDS=5400
# 盘外（收盘后、非交易日）的空闲回收超时，秒。分成两个值是因为 90 分钟的唯一依据
# 是"盖住午休"，而午休只在盘中存在；收盘后到次日开盘 18 小时、周末更长，让浏览器
# 那 378 MiB 空转 90 分钟纯属白占（实测热空闲 621 MiB，拆掉后 243 MiB）。
# 置 0 = 盘外不回收，盘中照旧。
BROWSER_IDLE_TIMEOUT_CLOSED_SECONDS=300
# 把无头浏览器的自报特征改成普通浏览器的样子。默认关：2026-09-07 部署机实测 main 的原样身份
# （无头、固定 UA、不伪装）今日块 36/36，只加 AutomationControlled 参数 26/36，完整伪装 23/36，
# 东财的数据接口对"伪装过的"反而拒得更多。置 1 才启用整套伪装（含那个启动参数），只用于对照。
BROWSER_DISGUISE=0
# 对外声明哪个平台：auto | real | macos | windows。
# auto = Windows/macOS 照实报，其余（服务器上的 Linux）统一报 macOS。
BROWSER_CLAIM_PLATFORM=auto
# 是否为 Chromium 添加 --no-sandbox；仅在受控容器确有需要时设为 1
BROWSER_NO_SANDBOX=0
# 下面两项由 start.sh 读取（不是 Python 进程），同样支持 ENV_PREFIX。
# Ubuntu 无 DISPLAY 时自动使用的 Xvfb 起始显示号；被占用则依次往后试到 109
XVFB_DISPLAY_NUMBER=99
# Ubuntu Xvfb 屏幕分辨率和色深
XVFB_SCREEN=1920x1080x24

# --- 参考数据 ---------------------------------------------------------------
# 指数名单、代码表、板块表（indices.json / markets.json / stock_sector.json）随包
# 发布，正常不用配。指到别的目录可以临时替换而不重装；只放要改的那个文件即可，
# 其余仍从包内读。名单为空或读不到一律回落到内置兜底名单并打 WARNING——空名单会
# 让 SH000xxx 被判成深市个股，那是错数据，不是缺数据。
# CONF_DIR=/etc/cn-stock-mcp/confs

# --- 调试开关（默认关，会显著抬高内存，只在排查时开）------------------------
# 资金流页面用有头浏览器加载，便于人工观察渲染结果
BROWSER_HEADFUL=0
# 抓完不关页面；每个页面是一个独立渲染进程
BROWSER_KEEP_PAGES=0
